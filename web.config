<?xml version="1.0" encoding="UTF-8"?>
<!--
  Site IIS reverse-proxy (URL Rewrite) sang tiến trình Node đang chạy
  .next/standalone, lắng nghe ở HOST/PORT khai trong .env (mặc định
  http://localhost:1357).

  QUAN TRỌNG: existingResponse="PassThrough" (không phải "Replace") — với
  "Replace", IIS thay TẤT CẢ response lỗi (kể cả 404 có nội dung thật từ
  Next.js) bằng trang lỗi mặc định của nó vì <httpErrors> bên dưới chỉ khai
  cho statusCode="502", không có mục cho 404 -> rơi về trang chung "The
  resource you are looking for has been removed...". Với "PassThrough", IIS
  chỉ dùng trang lỗi tùy chỉnh khi CHÍNH IIS tạo ra lỗi (không có nội dung,
  vd Node thực sự sập -> đúng 502 thật vẫn hiện errors/502.html), còn response
  đã có nội dung thật từ Next.js (not-found.jsx, v.v.) thì để nguyên, không đụng vào.

  File này được copy-standalone-assets.mjs tự copy vào .next/standalone/web.config
  sau mỗi lần build (nếu tồn tại ở gốc project).
-->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="skip-errors" stopProcessing="true">
                    <match url="^errors/.*" />
                    <action type="None" />
                </rule>
                <rule name="locahost1357" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://localhost:1357/{R:1}" />
                </rule>
            </rules>
        </rewrite>

        <httpErrors errorMode="Custom" existingResponse="PassThrough">
            <clear />
            <error statusCode="502" path="errors\502.html" responseMode="File" />
        </httpErrors>
    </system.webServer>
</configuration>
