# ==== Host & Port chạy ứng dụng ====
# HOST=0.0.0.0 để lắng nghe mọi giao diện mạng (thiết bị LAN vào bằng IP máy chủ)
HOST=0.0.0.0
PORT=2468

# ==== Kết nối MySQL / MariaDB ====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=DB_UI
DB_USER=root
DB_PASSWORD='Mysql2025!@#'

# Cho phép so khớp mật khẩu dạng plaintext (chỉ bật khi cần cho hệ thống cũ)
ALLOW_PLAINTEXT_PASSWORD=false

# ==== Bảo mật phiên đăng nhập ====
# Khóa bí mật để ký cookie phiên (HMAC-SHA256). BẮT BUỘC phải có.
# Đổi sang giá trị ngẫu nhiên riêng cho môi trường production.
SESSION_SECRET=qQ05KrQ2wytf38y4PcHKK7reuqhm5gZtJYf2z2srcuqkNGOFBbqtmIlQg3CaA9hH

# Đặt =true CHỈ khi chạy qua HTTPS (cookie Secure). Deploy LAN qua HTTP thì để false.
COOKIE_SECURE=false
